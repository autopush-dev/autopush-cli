{
  "name": "@autopush/cli",
  "version": "0.3.1",
  "description": "Deploy static sites to AutoPush from the command line.",
  "homepage": "https://autopush.dev",
  "author": "AutoPush",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autopush-dev/autopush-cli.git"
  },
  "bugs": {
    "url": "https://github.com/autopush-dev/autopush-cli/issues"
  },
  "bin": {
    "autopush": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "autopush",
    "deploy",
    "static",
    "hosting",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.7.7",
    "commander": "^12.1.0",
    "form-data": "^4.0.1",
    "ora": "^5.4.1",
    "picocolors": "^1.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
